generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ejemplo {
  id          Int     @id @default(autoincrement())
  descripcion String
  otros       String?
  datecreate  DateTime @default(now()) // Fecha actual automática
  @@map("ejemplo")
}
